# Base URL the app prepends to every API request (used by src/api/client.ts).
# In production point this at your API origin (e.g. https://api.example.com/api/v1).
# In development leave it as /api/v1 so requests hit the Vite dev proxy below.
VITE_API_BASE_URL=/api/v1

# Dev-only: the origin the Vite dev proxy forwards `/api` requests to
# (see the `server.proxy` block in vite.config.ts). Ignored in production.
VITE_API_TARGET=http://127.0.0.1:8000
